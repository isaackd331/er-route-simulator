    "next": "16.2.6",
    "react": "19.2.4",
    "react-cookie": "8.1.2",
    "react-dom": "19.2.4",
    "react-hook-form": "7.75.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4",
    "@tanstack/eslint-plugin-query": "5.100.10",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "env-cmd": "11.0.0",
    "eslint": "9",
    "eslint-config-next": "16.2.6",
